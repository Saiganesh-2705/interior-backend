PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/luxe-interiors
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@luxeinteriors.com
ADMIN_PASSWORD=Admin@123

# AI chatbot. With a key, Aria is powered by Claude and answers anything the visitor types.
# Leave it empty to use the built-in conversation engine. Check which one is live: http://localhost:5001/api/chat/status
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
